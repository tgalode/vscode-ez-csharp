{
  "name": "ezsharp",
  "displayName": "ezsharp",
  "description": "Work on a slice of a large .NET solution. Generate .slnf solution filters, switch between them, and scope the C# language server to the one you need.",
  "version": "0.5.0",
  "license": "MIT",
  "publisher": "tgalode",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "dotnet",
    "csharp",
    "solution",
    "slnf",
    "slnx"
  ],
  "extensionDependencies": [],
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/*.slnf",
    "onView:ezsharp.slice"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ezsharp.switchScope",
        "title": "Switch Scope",
        "category": "ezsharp"
      },
      {
        "command": "ezsharp.generateFilter",
        "title": "Generate Filter (.slnf)",
        "category": "ezsharp"
      },
      {
        "command": "ezsharp.clearScope",
        "title": "Clear Scope",
        "category": "ezsharp"
      },
      {
        "command": "ezsharp.refresh",
        "title": "Refresh Discovery",
        "category": "ezsharp"
      },
      {
        "command": "ezsharp.showLog",
        "title": "Show Log",
        "category": "ezsharp"
      },
      {
        "command": "ezsharp.slice.save",
        "title": "Save Slice as .slnf",
        "category": "ezsharp",
        "icon": "$(save)"
      },
      {
        "command": "ezsharp.slice.apply",
        "title": "Apply Slice",
        "category": "ezsharp",
        "icon": "$(check)"
      },
      {
        "command": "ezsharp.slice.reset",
        "title": "Reset Slice",
        "category": "ezsharp",
        "icon": "$(clear-all)"
      },
      {
        "command": "ezsharp.slice.refresh",
        "title": "Refresh Slice",
        "category": "ezsharp",
        "icon": "$(refresh)"
      },
      {
        "command": "ezsharp.slice.selectSolution",
        "title": "Select Solution",
        "category": "ezsharp",
        "icon": "$(list-selection)"
      },
      {
        "command": "ezsharp.slice.toggleProject",
        "title": "Toggle Project in Slice",
        "category": "ezsharp"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ezsharp",
          "title": "ezsharp",
          "icon": "media/ezsharp.svg"
        }
      ]
    },
    "views": {
      "ezsharp": [
        {
          "id": "ezsharp.slice",
          "name": "Slice"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "ezsharp.slice.toggleProject",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "ezsharp.slice.selectSolution",
          "when": "view == ezsharp.slice",
          "group": "navigation@1"
        },
        {
          "command": "ezsharp.slice.save",
          "when": "view == ezsharp.slice",
          "group": "navigation@2"
        },
        {
          "command": "ezsharp.slice.apply",
          "when": "view == ezsharp.slice",
          "group": "navigation@3"
        },
        {
          "command": "ezsharp.slice.refresh",
          "when": "view == ezsharp.slice",
          "group": "navigation@4"
        },
        {
          "command": "ezsharp.slice.reset",
          "when": "view == ezsharp.slice",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "ezsharp",
      "properties": {
        "ezsharp.configuration": {
          "type": "string",
          "default": "Debug",
          "description": "MSBuild configuration used to resolve conditional ProjectReference entries. Set this when your projects wire dependencies differently per configuration."
        },
        "ezsharp.includeTestProjects": {
          "type": "boolean",
          "default": true,
          "description": "When generating a filter, also include projects that reference the selection and look like test projects."
        },
        "ezsharp.restartLanguageServerOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Run the C# extension's 'Restart .NET Language Server' command after switching scope."
        },
        "ezsharp.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the current scope in the status bar."
        },
        "ezsharp.exclude": {
          "type": "string",
          "default": "**/{node_modules,bin,obj,.git}/**",
          "description": "Glob pattern excluded when discovering solution and filter files."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.integration.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production",
    "check": "npm run typecheck && npm run test",
    "package": "vsce package --no-dependencies",
    "build:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run build && npm run build:integration && vscode-test --label integration",
    "test:integration:csharp": "npm run build && npm run build:integration && vscode-test --label csharp",
    "test:integration:multiroot": "npm run build && npm run build:integration && vscode-test --label multi-root",
    "test:integration:all": "npm run build && npm run build:integration && vscode-test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "mocha": "^11.7.6",
    "ovsx": "^0.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tgalode/vscode-ez-csharp.git"
  },
  "bugs": {
    "url": "https://github.com/tgalode/vscode-ez-csharp/issues"
  }
}
